# Local runs only. Read by cli.ts, eval.ts and the scripts/ tools.
# In CI these come from Action inputs and repository secrets instead.
#
# A real environment variable always wins over this file, and a key left blank
# here is ignored rather than set -- so an empty GITHUB_TOKEN= will not shadow
# the `gh auth token` fallback.

# Required.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Leave it out entirely to reuse your `gh auth login` session, which
# is what most local runs should do.
# GITHUB_TOKEN=ghp_...

# ---- Web demo server (npm start / Docker) -----------------------------------
# All optional. See README "Web demo" for the full list.
# PORT=8787
# TRUST_PROXY=1               # set behind a reverse proxy such as Railway
# REVIEWS_PER_IP_PER_HOUR=3
# REVIEWS_PER_DAY=150
# REVIEW_MODEL=z-ai/glm-5.3-flash
# REVIEW_VERIFY_MODEL=deepseek/deepseek-v4-flash
