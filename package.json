{
  "name": "pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "AI code review assistant for GitHub pull requests, powered by OpenRouter",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "build:cli": "ncc build src/cli.ts -o dist-cli --source-map",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval.ts",
    "review": "tsx src/cli.ts",
    "check:plumbing": "tsx scripts/plumbing-check.ts",
    "check:model": "tsx scripts/smoke-model.ts",
    "build:server": "ncc build src/server/main.ts -o dist-server --minify",
    "build:web": "vite build --config web/vite.config.ts",
    "build:demo": "npm run build:web && npm run build:server",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist-server/index.js",
    "seed:samples": "tsx scripts/seed-samples.ts"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@hono/node-server": "^2.1.6",
    "@octokit/rest": "^21.1.1",
    "hono": "^4.13.17",
    "js-tiktoken": "^1.0.20",
    "js-yaml": "^4.1.0",
    "openai": "^4.104.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/ncc": "^0.38.3",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.8"
  }
}
