    {
      "id": "0404f6f75d9b6403",
      "file": "lib/request.js",
      "line": 392,
      "category": "edge-case",
      "severity": "low",
      "confidence": 0.6,
      "title": "Malformed bracketed Host header produces a wrong slice",
      "body": "`hostname.indexOf(']')` returns -1 when the Host header is a malformed IPv6 literal without a closing bracket (e.g. `Host: [::1`), so `hostname.slice(1, -1)` silently drops the last character instead of handling the malformed input. The result then flows into `isIP`/split and yields garbage subdomains. Consider falling back to the unstripped hostname when `indexOf(']') === -1`.",
      "failureScenario": "Request with `Host: [::1` (attacker-controllable header) makes `req.subdomains` compute from the mangled string `\":1\"` rather than the original hostname.",
      "suggestion": null,
      "placement": "refuted",
      "original": null,
      "verdict": {
        "refuted": true,
        "reason": "The `hostname` getter (lines 449–463) processes the raw Host header before it reaches the `subdomains` getter. For a malformed IPv6 literal like `[::1`, the getter returns `[` (a single bracket), not the original string. Therefore the `subdomains` getter never receives `[::1` and the claimed slice producing `:1` cannot occur."
      }
    }
  ],
